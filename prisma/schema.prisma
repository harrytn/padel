// Padel Court Booking System — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  id                    Int    @id @default(1)
  base_price            Float  @default(100)
  racket_price_with_balls Float @default(5)
  balls_only_price      Float  @default(10)
  lighting_price        Float  @default(20)
  peak_premium          Float  @default(10)
  open_hour             String @default("08:00")
  close_hour            String @default("22:00")
  lighting_trigger_hour String @default("18:30")
  peak_slots            String @default("[\"17:00\",\"18:30\",\"20:00\"]")
  slot_duration_minutes Int    @default(90)
  currency              String @default("TND")
}

model Booking {
  id                  String        @id @default(uuid())
  booking_pin         String
  type                String        @default("TOURIST_BOOKING")
  customer_first_name String?
  customer_last_name  String?
  room_number         String?
  date                String
  slot_start          String
  duration_minutes    Int           @default(90)
  racket_count        Int           @default(0)
  bought_balls_only   Boolean       @default(false)
  needs_lighting      Boolean       @default(false)
  total_price         Float         @default(0)
  currency            String        @default("TND")
  status              String        @default("PENDING_PAYMENT")
  created_at          DateTime      @default(now())

  // Operational Timestamps (Reception Workflow)
  checked_in_at       DateTime?
  paid_at             DateTime?
  cancelled_at        DateTime?
  no_show_at          DateTime?

  // Active slot uniqueness is enforced by a PostgreSQL partial unique index 
  // ("Booking_active_slot_key") migration, not Prisma schema.
}
